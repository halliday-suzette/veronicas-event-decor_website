---
/**
 * One of Verónica's photos from src/assets/photos/ (listed in src/data/photos.ts).
 * Renders an optimized WebP with explicit width/height (no layout shift), cropped to the given
 * aspect ratio, lazy-loaded unless `priority`. Renders nothing if the file doesn't exist yet —
 * the surrounding card decides how to look without a photo (use `hasPhoto()`).
 */
import { Image } from 'astro:assets';
import { fitSize, resolvePhoto } from '../lib/photos';
import type { L10n } from '../data/types';
import type { Lang } from '../i18n/utils';

interface Props {
  file: string | undefined;
  lang: Lang;
  /** Requested output size; sets the aspect ratio (the photo is cropped to fit). */
  width: number;
  height: number;
  widths: number[];
  sizes: string;
  altOverride?: L10n;
  priority?: boolean;
  class?: string;
}

const {
  file,
  lang,
  width,
  height,
  widths,
  sizes,
  altOverride,
  priority = false,
  class: className = '',
} = Astro.props;
const photo = resolvePhoto(file, lang, altOverride);
const size = photo?.src ? fitSize(photo.src, width, height, widths) : undefined;
---

{photo?.src && size && (
  <Image
    src={photo.src}
    alt={photo.alt}
    width={size.width}
    height={size.height}
    widths={size.widths}
    sizes={sizes}
    format="webp"
    quality={68}
    fit="cover"
    position={photo.position}
    priority={priority}
    class:list={['w-full object-cover', !/\bh-/.test(className) && 'h-auto', className]}
  />
)}
