---
/**
 * FAQ (#faq): accessible accordion built on native <details>/<summary>. The same data
 * (src/data/faq.ts) feeds the FAQPage structured data in HomePage.astro.
 */
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { faq } from '../data/faq';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="faq" aria-labelledby="faq-title" class="section-cream py-20 sm:py-24 lg:py-28">
  <div class="mx-auto max-w-3xl px-5 sm:px-6 lg:px-8">
    <SectionHeading id="faq-title" tone="light" eyebrow={t.faq.eyebrow} title={t.faq.title} />

    <div class="divide-y divide-whiskey-light/60 rounded-lg border border-whiskey-light/60 bg-white/60 shadow-soft">
      {faq.map((item) => (
        <details class="faq-item group">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-serif text-lg font-semibold text-whiskey-dark sm:px-6 sm:text-xl [&::-webkit-details-marker]:hidden">
            <h3>{item.question[lang]}</h3>
            <Icon
              name="chevronDown"
              class="faq-chevron size-5 shrink-0 text-whiskey transition-transform group-open:rotate-180"
              strokeWidth={2}
            />
          </summary>
          <p class="px-5 pb-5 text-charcoal/90 sm:px-6">{item.answer[lang]}</p>
        </details>
      ))}
    </div>
  </div>
</section>
