---
/** #rentals: Signature Barrel Tables, then the full rentals catalog. */
import RentalsCatalog from './RentalsCatalog.astro';
import SignatureBarrels from './SignatureBarrels.astro';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="rentals" aria-labelledby="rentals-title" class="section-dark py-20 sm:py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <SignatureBarrels lang={lang} />
    <RentalsCatalog lang={lang} />
  </div>
</section>
