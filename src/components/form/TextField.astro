---
/**
 * Labeled text input or textarea with optional help text and an inline error slot
 * (filled by the QuoteForm script). Error and help are linked via aria-describedby.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'date' | 'number';
  required?: boolean;
  multiline?: boolean;
  rows?: number;
  placeholder?: string;
  help?: string;
  autocomplete?: HTMLAttributes<'input'>['autocomplete'];
  inputmode?: HTMLAttributes<'input'>['inputmode'];
  min?: string;
  step?: string;
  pattern?: string;
  maxlength?: number;
  /** Short text shown inside the input on the left, e.g. "$". */
  prefix?: string;
  class?: string;
}

const {
  name,
  label,
  type = 'text',
  required = false,
  multiline = false,
  rows = 5,
  placeholder,
  help,
  autocomplete,
  inputmode,
  min,
  step,
  pattern,
  maxlength,
  prefix,
  class: className = '',
} = Astro.props;

const helpId = help ? `${name}-help` : undefined;
const errorId = `${name}-error`;
const describedBy = [helpId, errorId].filter(Boolean).join(' ');
---

<div class={className}>
  <label for={name} class="form-label">
    {label}
    {required && (
      <span class="text-whiskey" aria-hidden="true">
        *
      </span>
    )}
  </label>
  {help && (
    <p id={helpId} class="form-help">
      {help}
    </p>
  )}
  {multiline ? (
    <textarea
      id={name}
      name={name}
      rows={rows}
      required={required}
      placeholder={placeholder}
      maxlength={maxlength}
      aria-describedby={describedBy}
      class="form-control min-h-32 resize-y"
    />
  ) : (
    <div class="relative">
      {prefix && (
        <span
          class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 font-bold text-whiskey-dark"
          aria-hidden="true"
        >
          {prefix}
        </span>
      )}
      <input
        id={name}
        name={name}
        type={type}
        required={required}
        placeholder={placeholder}
        autocomplete={autocomplete}
        inputmode={inputmode}
        min={min}
        step={step}
        pattern={pattern}
        maxlength={maxlength}
        aria-describedby={describedBy}
        class:list={['form-control', prefix && 'pl-8']}
      />
    </div>
  )}
  <p id={errorId} class="form-error" data-error-for={name}></p>
</div>
