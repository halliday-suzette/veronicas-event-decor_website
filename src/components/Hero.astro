---
/**
 * Hero (#home). Shows the full logo with a warm gold glow, beside the headline on desktop
 * and above it on mobile.
 *
 * To use a real event photo later (set in HomePage.astro):
 *   - backgroundImage: photo sits behind everything under a dark overlay (logo stays)
 *   - featureImage + featureAlt: photo replaces the logo in the feature column
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Logo from './Logo.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  backgroundImage?: ImageMetadata;
  featureImage?: ImageMetadata;
  featureAlt?: string;
}

const { lang, backgroundImage, featureImage, featureAlt = '' } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="home"
  aria-labelledby="hero-title"
  class="section-dark relative isolate overflow-hidden"
>
  {backgroundImage && (
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <Picture
        src={backgroundImage}
        alt=""
        formats={['avif', 'webp']}
        widths={[640, 1024, 1536, 2048]}
        sizes="100vw"
        priority
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-onyx/85 via-onyx/75 to-onyx/95" />
    </div>
  )}

  <div class="mx-auto grid max-w-7xl items-center gap-8 px-5 pt-8 pb-16 sm:px-6 sm:pt-12 lg:grid-cols-[1.15fr_1fr] lg:gap-12 lg:px-8 lg:py-20 xl:py-24">
    <div class="relative mx-auto w-full max-w-[720px]">
      <div class="hero-glow absolute -inset-[12%] -z-10 rounded-full" aria-hidden="true"></div>
      {featureImage ? (
        <Picture
          src={featureImage}
          alt={featureAlt}
          formats={['avif', 'webp']}
          widths={[400, 640, 960, 1280]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          priority
          class="h-auto w-full rounded-lg border border-gold-deep/50 shadow-soft"
        />
      ) : (
        <Logo lang={lang} variant="full" priority />
      )}
    </div>

    <div class="text-center lg:text-left">
      <p class="font-western text-xs leading-relaxed tracking-[0.18em] text-gold uppercase sm:text-sm">
        {t.hero.eyebrow}
      </p>
      <h1
        id="hero-title"
        class="mt-4 text-[2rem] leading-[1.15] font-semibold text-cream sm:text-5xl lg:text-[3.25rem] xl:text-6xl"
      >
        {t.hero.title}
      </h1>
      <hr class="gold-rule mx-auto mt-6 max-w-48 lg:mx-0" />
      <p class="mx-auto mt-6 max-w-xl text-lg text-cream/85 lg:mx-0">{t.hero.subtitle}</p>
      <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <a href="#quote" class="btn-gold">
          {t.cta.quote}
        </a>
        <a href="#rentals" class="btn-outline">
          {t.cta.rentals}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-glow {
    background: radial-gradient(
      closest-side,
      rgb(247 210 102 / 0.2),
      rgb(230 170 30 / 0.12) 45%,
      rgb(162 104 10 / 0.05) 70%,
      transparent
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-glow {
      animation: candlelight 7s ease-in-out infinite alternate;
    }
  }

  @keyframes candlelight {
    from {
      opacity: 0.8;
      transform: scale(0.98);
    }
    to {
      opacity: 1;
      transform: scale(1.02);
    }
  }
</style>
