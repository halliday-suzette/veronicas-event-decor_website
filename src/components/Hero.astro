---
/**
 * Hero (#home): background event photo under a dark gradient (for legibility), the lit
 * logo, the H1 and the two calls to action. The photo is `heroPhoto` in src/data/photos.ts;
 * until the file exists, the hero shows the plain onyx background.
 */
import Logo from './Logo.astro';
import { heroBackground } from '../lib/hero';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const background = await heroBackground();
// 1×1 transparent GIF: the <img> fallback on phones, so no photo is downloaded there.
const EMPTY_IMAGE =
  'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<section
  id="home"
  aria-labelledby="hero-title"
  class="section-dark relative isolate overflow-hidden"
>
  {background && (
    <div class="absolute inset-0 -z-10 hidden sm:block" aria-hidden="true">
      {/* From 640px up the <source> supplies the photo (largest element → eager, high priority,
          preloaded in <head>). On phones the empty inline image is used: no request at all. */}
      <picture>
        <source
          media={background.media}
          srcset={background.srcset}
          sizes={background.sizes}
          type="image/webp"
        />
        <img
          src={EMPTY_IMAGE}
          alt=""
          width={background.width}
          height={background.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </picture>
      {/* At least 80% onyx everywhere: text stays WCAG AA even over a white patch of photo. */}
      <div class="absolute inset-0 bg-gradient-to-b from-onyx/90 via-onyx/80 to-onyx/95" />
      <div class="absolute inset-0 bg-gradient-to-r from-onyx/60 via-transparent to-onyx/70" />
    </div>
  )}

  <div class="mx-auto grid max-w-7xl items-center gap-8 px-5 pt-8 pb-16 sm:px-6 sm:pt-12 lg:grid-cols-[1fr_1.1fr] lg:gap-12 lg:px-8 lg:py-20 xl:py-24">
    <div class="relative mx-auto w-full max-w-[640px]">
      <div class="hero-glow absolute -inset-[12%] -z-10 rounded-full" aria-hidden="true"></div>
      {/* The logo is the largest visible element, so it loads first; the darkened background
          photo is decorative and loads at low priority. */}
      <Logo lang={lang} variant="full" priority />
    </div>

    <div class="text-center lg:text-left">
      <p class="font-western text-xs leading-relaxed tracking-[0.16em] text-gold uppercase sm:text-sm">
        {t.hero.eyebrow}
      </p>
      <h1
        id="hero-title"
        class="mt-4 text-[2rem] leading-[1.15] font-semibold text-cream sm:text-5xl lg:text-[3.1rem] xl:text-[3.4rem]"
      >
        {t.hero.title}
      </h1>
      <hr class="gold-rule mx-auto mt-6 max-w-48 lg:mx-0" />
      <p class="mx-auto mt-6 max-w-xl text-lg text-cream/90 lg:mx-0">{t.hero.subtitle}</p>
      <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <a href="#quote" class="btn-gold">
          {t.hero.primary}
        </a>
        <a href="#rentals" class="btn-outline bg-onyx/40">
          {t.hero.secondary}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-glow {
    background: radial-gradient(
      closest-side,
      rgb(247 210 102 / 0.2),
      rgb(230 170 30 / 0.12) 45%,
      rgb(162 104 10 / 0.05) 70%,
      transparent
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-glow {
      animation: candlelight 7s ease-in-out infinite alternate;
    }
  }

  @keyframes candlelight {
    from {
      opacity: 0.8;
      transform: scale(0.98);
    }
    to {
      opacity: 1;
      transform: scale(1.02);
    }
  }
</style>
