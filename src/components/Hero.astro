---
/**
 * Hero (#home): eyebrow, H1, a short intro and the two calls to action, then a real photo of
 * Verónica's whiskey barrel tables (`heroPhoto` in src/data/photos.ts) and chips for the main
 * celebrations. The header logo is the brand mark, so the hero has no logo of its own.
 *
 *   Phones/tablets: stacked — text, buttons, photo, chips (CTA and part of the photo above the fold).
 *   Desktop (lg):   text + chips on the left, photo on the right; the hero stays under ~85vh.
 *
 * The photo is the LCP element: eager, high priority, and preloaded in <head> (src/lib/hero.ts).
 */
import { celebrations } from '../data/celebrations';
import { heroImage } from '../lib/hero';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const photo = await heroImage(lang);
// The main celebrations (quinceañeras, sweet 16s, graduations, birthdays), linked to their cards.
const mainEvents = celebrations.filter((c) => c.tier === 'primary');
---

<section
  id="home"
  aria-labelledby="hero-title"
  class="section-dark relative isolate overflow-hidden"
>
  <div class="mx-auto grid max-w-7xl gap-y-7 px-5 pt-6 pb-10 sm:px-6 sm:pt-10 sm:pb-14 lg:grid-cols-[1fr_1.05fr] lg:gap-x-12 lg:gap-y-6 lg:px-8 lg:py-10 xl:gap-x-16 xl:py-12">
    <div class="text-center lg:col-start-1 lg:row-start-1 lg:self-end lg:text-left">
      <p
        data-hero-eyebrow
        class="font-western text-[0.7rem] leading-relaxed tracking-[0.14em] text-gold-soft uppercase sm:text-sm"
      >
        {t.hero.eyebrow}
      </p>
      <h1
        id="hero-title"
        class="mt-3 text-[1.55rem] leading-[1.15] font-semibold text-cream min-[380px]:text-[1.7rem] min-[400px]:text-[1.85rem] sm:mt-4 sm:text-[2.6rem] lg:text-[2.5rem] xl:text-5xl"
      >
        {t.hero.title}
      </h1>
      <p
        data-hero-intro
        class="mx-auto mt-4 max-w-xl text-base text-cream/90 sm:mt-5 sm:text-lg lg:mx-0"
      >
        {t.hero.intro}
      </p>
      <div class="mt-6 flex flex-col items-center gap-1 sm:flex-row sm:justify-center sm:gap-4 lg:justify-start">
        <a href="#quote" class="btn-gold w-full sm:w-auto">
          {t.hero.primary}
        </a>
        {/* A text link on phones (saves space above the fold); an outline button from 640px. */}
        <a
          href="#rentals"
          class="btn border border-transparent text-gold-soft underline decoration-gold/60 underline-offset-4 hover:decoration-gold-soft sm:border-gold/70 sm:no-underline sm:hover:border-gold-soft sm:hover:bg-gold/10"
        >
          {t.hero.secondary}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    {photo && (
      <div
        data-hero-photo
        class="relative mx-auto w-full max-w-2xl lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:max-w-none lg:self-center"
      >
        <div class="hero-glow absolute -inset-[10%] -z-10 rounded-full" aria-hidden="true" />
        {/* Gold double frame, matching the theme's framed cards. */}
        <div class="rounded-xl border border-gold-deep/60 p-1.5 shadow-soft sm:p-2">
          <picture>
            <source type="image/avif" srcset={photo.avifSrcset} sizes={photo.sizes} />
            <source type="image/webp" srcset={photo.webpSrcset} sizes={photo.sizes} />
            <img
              src={photo.fallbackSrc}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-[4/3] w-full rounded-lg border border-gold/50 object-cover lg:max-h-[calc(85vh-12rem)]"
              style={photo.position ? `object-position: ${photo.position}` : undefined}
            />
          </picture>
        </div>
      </div>
    )}

    <div class="text-center lg:col-start-1 lg:row-start-2 lg:self-start lg:text-left">
      <p id="hero-events-label" class="text-sm font-bold tracking-wide text-cream/80">
        {t.hero.eventsLabel}
      </p>
      <ul
        aria-labelledby="hero-events-label"
        class="mt-2 flex flex-wrap justify-center gap-2 lg:justify-start"
      >
        {mainEvents.map((c) => (
          <li>
            <a
              href={`#celebration-${c.id}`}
              class="inline-flex min-h-11 items-center rounded-full border border-gold/50 bg-gold/5 px-4 text-sm font-bold text-gold-soft transition hover:border-gold-soft hover:bg-gold/15"
            >
              {c.name[lang]}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero-glow {
    background: radial-gradient(
      closest-side,
      rgb(247 210 102 / 0.16),
      rgb(230 170 30 / 0.08) 50%,
      transparent
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-glow {
      animation: candlelight 7s ease-in-out infinite alternate;
    }
  }

  @keyframes candlelight {
    from {
      opacity: 0.75;
    }
    to {
      opacity: 1;
    }
  }
</style>
