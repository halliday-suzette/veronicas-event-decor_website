---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" aria-labelledby="about-title" class="section-cream py-20 sm:py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <SectionHeading id="about-title" tone="light" eyebrow={t.about.eyebrow} title={t.about.title} />

    <div class="mx-auto max-w-3xl space-y-5 text-center text-lg text-charcoal">
      {t.about.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <ul class="mt-14 grid gap-6 md:grid-cols-3">
      {t.about.values.map((value) => (
        <li class="rounded-lg border border-whiskey-light/50 bg-white/50 p-7 text-center shadow-soft">
          <span class="mx-auto flex size-16 items-center justify-center rounded-full bg-onyx text-gold ring-1 ring-gold-deep ring-offset-4 ring-offset-cream">
            <Icon name={value.icon} class="size-8" />
          </span>
          <h3 class="mt-6 text-2xl font-semibold text-whiskey-dark">{value.title}</h3>
          <p class="mt-3 text-charcoal/85">{value.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
