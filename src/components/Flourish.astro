---
/**
 * Small symmetrical flourish divider in gold — a simple nod to the logo's filigree
 * (custom drawing, not a copy of the logo artwork). Always decorative.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 240 28"
  fill="none"
  class:list={['mx-auto h-5 w-44 text-gold sm:h-6 sm:w-52', className]}
  aria-hidden="true"
  focusable="false"
>
  <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
    <path d="M6 14h62"></path>
    <path d="M68 14c10 0 15-8 23-8 7 0 9 7 3.5 8.5-4 1-6-3.5-2.5-5"></path>
    <path d="M68 14c10 0 15 8 23 8 7 0 9-7 3.5-8.5"></path>
    <g transform="matrix(-1 0 0 1 240 0)">
      <path d="M6 14h62"></path>
      <path d="M68 14c10 0 15-8 23-8 7 0 9 7 3.5 8.5-4 1-6-3.5-2.5-5"></path>
      <path d="M68 14c10 0 15 8 23 8 7 0 9-7 3.5-8.5"></path>
    </g>
  </g>
  <path d="M120 5l7 9-7 9-7-9Z" fill="currentColor"></path>
  <circle cx="106" cy="14" r="2" fill="currentColor"></circle>
  <circle cx="134" cy="14" r="2" fill="currentColor"></circle>
</svg>
