---
/**
 * Simple line icons (inline SVG, no icon font or CDN). Decorative by default (aria-hidden);
 * pass `label` when the icon is the only content of a link or button.
 */
const paths = {
  sparkle:
    '<path d="M12 3l1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8Z"/><path d="M19 15l.7 1.8 1.8.7-1.8.7L19 20l-.7-1.8-1.8-.7 1.8-.7Z"/>',
  gem: '<path d="M6.5 4h11L21 9l-9 11L3 9Z"/><path d="M3 9h18M9.5 4 8 9l4 11 4-11-1.5-5"/>',
  chat: '<path d="M4 4h11a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H9l-4 3v-3H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"/><path d="M16 8h4a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-1v3l-4-3h-3a1 1 0 0 1-1-1v-2"/>',
  cocktailTable:
    '<path d="M4 4h16"/><path d="M8 4c-1.2 3-1.2 13 0 16h8c1.2-3 1.2-13 0-16"/><path d="M7.2 9h9.6M7.2 15h9.6"/>',
  barrel:
    '<path d="M7 3h10c1.6 3 1.6 15 0 18H7C5.4 18 5.4 6 7 3Z"/><path d="M5.9 8h12.2M5.9 16h12.2M12 3v18"/>',
  backdrop:
    '<rect x="3" y="3" width="18" height="14" rx="1"/><path d="M3 7.7h18M3 12.3h18M9 3v4.7M15 7.7v4.6M8 12.3V17M7 17l-1.5 4M17 17l1.5 4"/>',
  balloons:
    '<circle cx="8.5" cy="8" r="4"/><circle cx="15.5" cy="7" r="3"/><circle cx="14.5" cy="13.5" r="2.8"/><path d="M8.5 12c-.6 2.5 1.5 4.5.5 9"/>',
  wheel:
    '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2"/><path d="M12 3v7M12 14v7M3 12h7M14 12h7M5.6 5.6l5 5M13.4 13.4l5 5M18.4 5.6l-5 5M10.6 13.4l-5 5"/>',
  hay: '<path d="M4 7h16l1 11H3Z"/><path d="M3.5 11h17M3.2 14.5h17.6M8 7l-.5 11M16 7l.5 11"/>',
  star: '<circle cx="12" cy="12" r="9"/><path d="M12 6.5l1.6 3.4 3.7.4-2.8 2.5.8 3.7L12 14.6l-3.3 1.9.8-3.7-2.8-2.5 3.7-.4Z"/>',
  lantern:
    '<path d="M9 3h6M12 3v2M8 5h8l1 3H7Z"/><path d="M8 8h8v10a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2Z"/><path d="M12 11c-1.3 1.6-1.3 3.2 0 4.3 1.3-1.1 1.3-2.7 0-4.3Z"/>',
  crown: '<path d="M3 8l4.5 4L12 5l4.5 7L21 8l-2 10H5Z"/><path d="M5 21h14"/>',
  cake: '<path d="M4 21h16M5 21v-8h14v8"/><path d="M5 16.5c2 1.5 3.5 1.5 5 0s3.5-1.5 5 0 3 1.5 4 0M12 13V9.5"/><path d="M12 7c-.9-.9-.9-2.2 0-3.5.9 1.3.9 2.6 0 3.5Z"/>',
  rings:
    '<circle cx="9" cy="14.5" r="5"/><circle cx="15" cy="14.5" r="5"/><path d="M10.5 6 12 3.5 13.5 6 12 8Z"/>',
  gift: '<rect x="3" y="9" width="18" height="12" rx="1"/><path d="M3 13h18M12 9v12"/><path d="M12 9c-1.5-3.5-5.5-4-5.5-1.5S9.5 9 12 9Zm0 0c1.5-3.5 5.5-4 5.5-1.5S14.5 9 12 9Z"/>',
  checklist:
    '<path d="M10 6h10M10 12h10M10 18h10"/><path d="M4 6l1.5 1.5L8 5M4 12l1.5 1.5L8 11M4 18l1.5 1.5L8 17"/>',
  truck:
    '<path d="M2.5 6h11v10h-11ZM13.5 9h4l3 3.5V16h-7Z"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>',
  pin: '<path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12Z"/><circle cx="12" cy="9" r="2.5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 7 8.5-7"/>',
  phone:
    '<path d="M5 3.5h3.5l1.5 4.5-2.2 1.5a11 11 0 0 0 6.7 6.7l1.5-2.2 4.5 1.5V19a2 2 0 0 1-2 2A17 17 0 0 1 3 5.5a2 2 0 0 1 2-2Z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  alert:
    '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5"/><circle cx="12" cy="16.5" r=".6" fill="currentColor"/>',
  arrowRight: '<path d="M5 12h14M13 6l6 6-6 6"/>',
} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: string;
  class?: string;
  label?: string;
  strokeWidth?: number;
}

const { name, class: className = 'size-6', label, strokeWidth = 1.5 } = Astro.props;
const svg = paths[name as IconName];
if (!svg)
  throw new Error(`Icon "${name}" does not exist. Available: ${Object.keys(paths).join(', ')}`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={svg}
/>
