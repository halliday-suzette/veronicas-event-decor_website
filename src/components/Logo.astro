---
/**
 * Veronica's Event Decor logo.
 *
 *   variant="full"    — complete logo with filigree (hero, footer)
 *   variant="compact" — center wordmark band only (header, mobile menu);
 *                       generated from logo.png by `npm run logo`
 *
 * TODO: A vector (SVG) logo would be sharper and smaller. If one exists, save it as
 * src/assets/images/logo.svg (and logo-wordmark.svg), change the logo import in
 * src/lib/logo.ts and the wordmark import below, and the rest of the site picks it up.
 */
import { Picture } from 'astro:assets';
import { LOGO_FULL } from '../lib/logo';
import logoWordmark from '../assets/images/logo-wordmark.png';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  variant?: 'full' | 'compact';
  /** Load immediately with high priority (use for the hero logo only). */
  priority?: boolean;
  /** Decorative copies (e.g. a second logo next to visible brand text) get alt="". */
  decorative?: boolean;
  class?: string;
}

const {
  lang,
  variant = 'full',
  priority = false,
  decorative = false,
  class: className = '',
} = Astro.props;
const t = useTranslations(lang);
const alt = decorative ? '' : t.logoAlt;
---

{variant === 'full' ? (
  /* Settings shared with the <head> preload (src/lib/logo.ts) so the URLs match exactly. */
  <Picture
    src={LOGO_FULL.src}
    alt={alt}
    formats={LOGO_FULL.formats}
    widths={LOGO_FULL.widths}
    sizes={LOGO_FULL.sizes}
    quality={LOGO_FULL.quality}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
    class:list={['h-auto w-full', className]}
  />
) : (
  <Picture
    src={logoWordmark}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[170, 220, 340, 440]}
    sizes="(min-width: 1024px) 220px, 165px"
    priority={priority}
    loading={priority ? undefined : 'eager'}
    class:list={['h-10 w-auto min-[360px]:h-12 lg:h-16', className]}
  />
)}
