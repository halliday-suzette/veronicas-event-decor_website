---
/**
 * The one-page site. Both src/pages/index.astro (English) and src/pages/es/index.astro
 * (Spanish) render this component, so sections only need to change here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Rentals from './Rentals.astro';
import Events from './Events.astro';
import Packages from './Packages.astro';
import ServiceArea from './ServiceArea.astro';
import Gallery from './Gallery.astro';
import type { Lang } from '../i18n/utils';

// To add a real event photo to the hero later, import it here and pass it below, e.g.
//   import heroPhoto from '../assets/images/hero.jpg';
//   <Hero lang={lang} backgroundImage={heroPhoto} />
// or replace the logo with the photo:
//   <Hero lang={lang} featureImage={heroPhoto} featureAlt="Rustic barrel setup at a quinceañera" />

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<BaseLayout lang={lang}>
  <Header lang={lang} />
  <main id="main" tabindex="-1">
    <Hero lang={lang} />
    <About lang={lang} />
    <Rentals lang={lang} />
    <Events lang={lang} />
    <Packages lang={lang} />
    <ServiceArea lang={lang} />
    <Gallery lang={lang} />
  </main>
</BaseLayout>
