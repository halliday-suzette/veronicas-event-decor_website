---
/**
 * The one-page site. Both src/pages/index.astro (English) and src/pages/es/index.astro
 * (Spanish) render this component, so the section order only lives here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Celebrations from './Celebrations.astro';
import Rentals from './Rentals.astro';
import AddOns from './AddOns.astro';
import Gallery from './Gallery.astro';
import WhyUs from './WhyUs.astro';
import HowItWorks from './HowItWorks.astro';
import About from './About.astro';
import QuoteForm from './QuoteForm.astro';
import Faq from './Faq.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n/utils';

// Structured data (WebSite, WebPage, LocalBusiness, FAQPage) is built in BaseLayout from
// src/lib/structured-data.ts. The hero photo is set in src/data/photos.ts (`heroPhoto`).

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<BaseLayout lang={lang}>
  <Header lang={lang} />
  <main id="main" tabindex="-1">
    <Hero lang={lang} />
    <Celebrations lang={lang} />
    <Rentals lang={lang} />
    <AddOns lang={lang} />
    <Gallery lang={lang} />
    <WhyUs lang={lang} />
    <HowItWorks lang={lang} />
    <About lang={lang} />
    <QuoteForm lang={lang} />
    <Faq lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
