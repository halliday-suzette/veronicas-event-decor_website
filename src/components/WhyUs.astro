---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="why-us" aria-labelledby="why-us-title" class="section-cream py-20 sm:py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <SectionHeading id="why-us-title" tone="light" eyebrow={t.why.eyebrow} title={t.why.title} />

    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {t.why.items.map((item) => (
        <li class="rounded-lg border border-whiskey-light/50 bg-white/50 p-7 text-center shadow-soft">
          <span class="mx-auto flex size-16 items-center justify-center rounded-full bg-onyx text-gold ring-1 ring-gold-deep ring-offset-4 ring-offset-cream">
            <Icon name={item.icon} class="size-8" />
          </span>
          <h3 class="mt-6 text-xl font-semibold text-whiskey-dark">{item.title}</h3>
          <p class="mt-3 text-charcoal/85">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
