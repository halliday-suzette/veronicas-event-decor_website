---
/** Instagram glyph as inline SVG (decorative — the surrounding link carries the label). */
interface Props {
  class?: string;
}

const { class: className = 'size-6' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect x="3" y="3" width="18" height="18" rx="5.2"></rect>
  <circle cx="12" cy="12" r="4.2"></circle>
  <circle cx="17.3" cy="6.7" r="1.15" fill="currentColor" stroke="none"></circle>
</svg>
