---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="packages"
  aria-labelledby="packages-title"
  class="section-dark py-20 sm:py-24 lg:py-28"
>
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <SectionHeading
      id="packages-title"
      eyebrow={t.packages.eyebrow}
      title={t.packages.title}
      intro={t.packages.intro}
    />

    <!-- How it works -->
    <ol class="grid gap-8 md:grid-cols-3 md:gap-6">
      {t.packages.steps.map((step, i) => (
        <li class="text-center">
          <span class="relative mx-auto flex size-16 items-center justify-center rounded-full border border-gold/70 text-gold">
            <Icon name={step.icon} class="size-7" />
            <span class="absolute -top-1 -right-1 flex size-7 items-center justify-center rounded-full bg-gold text-sm font-bold text-onyx">
              {i + 1}
            </span>
          </span>
          <h3 class="mt-5 text-xl font-semibold text-gold-soft">{step.title}</h3>
          <p class="mx-auto mt-2 max-w-xs text-cream/80">{step.text}</p>
        </li>
      ))}
    </ol>

    <hr class="gold-rule mx-auto my-14 max-w-3xl" />

    <!-- Example concepts (no prices) -->
    <div class="text-center">
      <h3 class="text-2xl font-semibold text-cream sm:text-3xl">{t.packages.examplesLabel}</h3>
      <p class="mx-auto mt-3 max-w-2xl text-cream/75">{t.packages.examplesNote}</p>
    </div>

    <ul class="mt-10 grid gap-6 lg:grid-cols-3">
      {t.packages.examples.map((pkg) => (
        <li class="relative flex flex-col rounded-lg border border-gold-deep/50 bg-charcoal p-7 shadow-soft">
          <span class="absolute top-0 left-7 -translate-y-1/2 rounded-full border border-gold-deep bg-onyx px-3 py-0.5 text-xs font-bold tracking-widest text-gold uppercase">
            {t.packages.exampleBadge}
          </span>
          <h4 class="mt-2 font-serif text-2xl font-semibold text-gold-soft">{pkg.title}</h4>
          <p class="mt-2 text-cream/80">{pkg.text}</p>
          <p class="mt-5 text-xs font-bold tracking-widest text-cream/70 uppercase">
            {t.packages.includesLabel}
          </p>
          <ul class="mt-3 space-y-2">
            {pkg.includes.map((item) => (
              <li class="flex gap-2.5 text-cream/90">
                <Icon name="check" class="mt-1 size-4 shrink-0 text-gold" strokeWidth={2.25} />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <div class="mt-12 text-center">
      <a href="#quote" class="btn-gold">
        {t.packages.cta}
      </a>
    </div>
  </div>
</section>
