---
import { getImage } from 'astro:assets';
import '../styles/global.css';
// The hero H1 font — preloaded so the headline renders sooner. (Body text is preloaded by nothing:
// on a slow phone connection a second font preload delays the hero logo, the LCP image.)
// Same files the CSS references, so the preload is reused (no double download).
import playfairUrl from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';
import Analytics from '../components/Analytics.astro';
import { site } from '../config/site';
import { heroPhoto } from '../data/photos';
import { resolvePhoto } from '../lib/photos';
import { heroBackground } from '../lib/hero';
import { logoPreload } from '../lib/logo';
import { buildGraph } from '../lib/structured-data';
import {
  absoluteUrl,
  hreflangCode,
  languages,
  localeUrl,
  useTranslations,
  withBase,
  type Lang,
} from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Every absolute URL below is built from Astro.site + base (src/config/site-url.mjs).
const canonical = localeUrl(lang, Astro.site);
const ogImage = absoluteUrl('/og-image.png', Astro.site);
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  hreflang: hreflangCode(l),
  href: localeUrl(l, Astro.site),
}));
const otherOgLocales = (Object.keys(languages) as Lang[])
  .filter((l) => l !== lang)
  .map((l) => useTranslations(l).meta.ogLocale);

// Hero preloads — same responsive URLs as the rendered images (no double download):
// the logo (LCP on phones) and, from 640px up, the background photo (LCP on larger screens).
const logo = await logoPreload();
const heroBg = await heroBackground();

// Primary image of the page for the structured data: the hero event photo, if present.
const hero = resolvePhoto(heroPhoto, lang);
const heroImage = hero?.src
  ? await getImage({ src: hero.src, width: Math.min(1200, hero.src.width), format: 'webp' })
  : undefined;
const primaryImage = heroImage
  ? {
      url: new URL(heroImage.src, Astro.site).href,
      width: Number(heroImage.attributes.width),
      height: Number(heroImage.attributes.height),
    }
  : undefined;

const jsonLd = buildGraph({ lang, t, siteUrl: Astro.site, pageUrl: canonical, primaryImage });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141210" />
    <meta name="color-scheme" content="dark light" />

    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={localeUrl('en', Astro.site)} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <!-- Critical resources: the hero logo (LCP) and the two above-the-fold fonts. -->
    <link
      rel="preload"
      as="image"
      type={logo.type}
      imagesrcset={logo.srcset}
      imagesizes={logo.sizes}
      fetchpriority="high"
    />
    {heroBg && (
      <link
        rel="preload"
        as="image"
        type="image/webp"
        media={heroBg.media}
        imagesrcset={heroBg.srcset}
        imagesizes={heroBg.sizes}
        fetchpriority="high"
      />
    )}
    <link rel="preload" as="font" type="font/woff2" href={playfairUrl} crossorigin />

    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />

    {site.googleSiteVerification && (
      <meta name="google-site-verification" content={site.googleSiteVerification} />
    )}
    {site.bingSiteVerification && <meta name="msvalidate.01" content={site.bingSiteVerification} />}

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {otherOgLocales.map((l) => (
      <meta property="og:locale:alternate" content={l} />
    ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {site.analytics.provider !== 'none' && <Analytics />}
  </head>
  <body>
    <a
      href="#main"
      class="fixed top-2 left-2 z-[100] -translate-y-24 rounded-md bg-gold px-4 py-3 font-bold text-onyx shadow-soft transition focus:translate-y-0"
    >
      {t.skipLink}
    </a>
    <slot />
  </body>
</html>
